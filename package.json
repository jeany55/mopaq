{
  "name": "mopaq",
  "version": "1.3.0",
  "description": "A universal JavaScript/TypeScript library for reading and creating MPQ (Blizzard MoPaQ) archive files, in Node.js and the browser",
  "keywords": [
    "mpq",
    "mopaq",
    "blizzard",
    "warcraft",
    "warcraft3",
    "starcraft",
    "diablo",
    "archive",
    "w3x",
    "w3m",
    "scx",
    "unpack",
    "extract",
    "browser",
    "isomorphic",
    "universal"
  ],
  "homepage": "https://github.com/jeany55/mopaq#readme",
  "bugs": {
    "url": "https://github.com/jeany55/mopaq/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jeany55/mopaq.git"
  },
  "license": "MIT",
  "author": "Jeany (https://github.com/jeany55)",
  "type": "commonjs",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "check:publish": "publint --strict",
    "check:exports": "attw --pack .",
    "verify": "npm run typecheck && npm test && npm run build && npm run check:publish && npm run check:exports",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "dependencies": {
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^26.4.0",
    "publint": "^0.3.24",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
